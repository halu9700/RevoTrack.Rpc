<Window x:Class="RevoTrack.Rpc.WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RevoTrack RPC Demo"
        Width="1040"
        Height="720"
        MinWidth="860"
        MinHeight="560"
        Background="#F4F6F8"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#D8DEE6"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"
                           Foreground="#253047"
                           Text="Host" />
                <TextBox x:Name="HostTextBox"
                         Grid.Column="1"
                         Width="160"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Padding="8,2"
                         Text="127.0.0.1" />
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="18,0,8,0"
                           FontWeight="SemiBold"
                           Foreground="#253047"
                           Text="Port" />
                <TextBox x:Name="PortTextBox"
                         Grid.Column="3"
                         Width="86"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Padding="8,2"
                         Text="53665" />

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusIndicator"
                             Width="9"
                             Height="9"
                             Margin="0,0,7,0"
                             Fill="#C2413B" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="#5B6575"
                               Text="Disconnected" />
                    <Button x:Name="ConnectButton"
                            Width="104"
                            Height="32"
                            Padding="12,0"
                            Click="ConnectButton_Click"
                            Content="Connect" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#D8DEE6"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,0,10">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#253047"
                                   Text="Methods" />
                        <Button x:Name="DownloadPointCloudButton"
                                Width="152"
                                Height="28"
                                HorizontalAlignment="Right"
                                Padding="8,0"
                                Click="DownloadPointCloudButton_Click"
                                Content="Download point cloud" />
                    </Grid>
                    <ListBox x:Name="MethodList"
                             Grid.Row="1"
                             BorderThickness="0"
                             DisplayMemberPath="Name"
                             SelectionChanged="MethodList_SelectionChanged" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1.05*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,8">
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#253047"
                               Text="Parameters JSON" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock x:Name="SelectedMethodText"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="#7A8494"
                                   Text="scanner/state" />
                        <Button x:Name="AutoExposureButton"
                                Width="112"
                                Height="28"
                                Padding="8,0"
                                Click="AutoExposureButton_Click"
                                Content="Auto exposure" />
                    </StackPanel>
                </Grid>

                <TextBox x:Name="ParametersTextBox"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         FontSize="13"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10"
                         VerticalScrollBarVisibility="Auto" />

                <Grid Grid.Row="3" Margin="2,0,2,8">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#253047"
                               Text="Messages" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Width="84"
                                Height="32"
                                Margin="0,0,8,0"
                                Padding="12,0"
                                Click="ClearLogButton_Click"
                                Content="Clear" />
                        <Button x:Name="SendButton"
                                Width="96"
                                Height="32"
                                Padding="12,0"
                                Click="SendButton_Click"
                                Content="Send" />
                    </StackPanel>
                </Grid>

                <TextBox x:Name="MessagesTextBox"
                         Grid.Row="4"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>
    </Grid>
</Window>
